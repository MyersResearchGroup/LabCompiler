<https://bioprotocols.org/labop/primitives/liquid_handling/PipetteMix> a <http://bioprotocols.org/labop#Primitive>,
        sbol:TopLevel ;
    ns1:ownedParameter <https://bioprotocols.org/labop/primitives/liquid_handling/PipetteMix/OrderedPropertyValue1>,
        <https://bioprotocols.org/labop/primitives/liquid_handling/PipetteMix/OrderedPropertyValue2>,
        <https://bioprotocols.org/labop/primitives/liquid_handling/PipetteMix/OrderedPropertyValue3>,
        <https://bioprotocols.org/labop/primitives/liquid_handling/PipetteMix/OrderedPropertyValue4> ;
    sbol:description "Mix by cycling a measured volume of liquid in and out at an array of samples a fixed number of times" ;
    sbol:displayId "PipetteMix" ;
    sbol:hasNamespace <https://bioprotocols.org/labop/primitives/liquid_handling> .

<https://bioprotocols.org/labop/primitives/liquid_handling/Transfer> a <http://bioprotocols.org/labop#Primitive>,
